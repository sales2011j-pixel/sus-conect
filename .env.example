# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE: Required for real Supabase database and authentication.
# Configure your Project URL and Anon/Publishable Key here.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"

# N8N: Webhook opcional para orquestração de fluxos do agente SUS ANA
N8N_WEBHOOK_URL="https://your-n8n-instance.com/webhook/sus-ana"

# N8N WHATSAPP (Evolution API): Webhook para envio automático de confirmação de teleconsulta
N8N_WHATSAPP_WEBHOOK_URL="https://n8n.pointcontrol.com.br/webhook/sus-conect-agendamento"
# Segredo opcional enviado no cabeçalho x-sus-webhook-secret para proteger o endpoint no n8n
N8N_WHATSAPP_SECRET=""
